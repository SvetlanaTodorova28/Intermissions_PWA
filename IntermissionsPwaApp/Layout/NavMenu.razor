<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Intermissions</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink href="https://cinemakoksijde.be/nl" class="nav-link" Match="NavLinkMatch.All">
                🍿 Cinema
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink href="shows" class="nav-link" Match="NavLinkMatch.All">
                🎬 Shows
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink href="archivedshows" class="nav-link" Match="NavLinkMatch.All" style="white-space: nowrap;">
                📦 Archived Shows
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink href="futurereleases" class="nav-link" Match="NavLinkMatch.All" style="white-space: nowrap;">
                <i class="bi bi-calendar3"></i> Future Releases
            </NavLink>
        </div>

    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}

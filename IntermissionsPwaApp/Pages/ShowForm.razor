@page "/showform"
@page "/showform/{Id}"
@using IntermissionsPwaApp.Services
@using IntermissionsPwaApp.Entities

@inject IShowService ShowService
@inject NavigationManager Nav

<h3 class="mb-4">@((IsEdit ? "🎬 Show bewerken" : "🎬 Nieuwe show toevoegen"))</h3>

<EditForm Model="@Show" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger mb-3" />

    <div class="mb-3">
        <label class="form-label">Titel</label>
        <InputText @bind-Value="Show.Title" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Pauze</label>
        <InputText @bind-Value="Show.Intermission" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Eind</label>
        <InputText @bind-Value="Show.End" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">KDM vervalt op</label>
        <InputDate @bind-Value="Show.KdmExpires" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success me-2">💾 Opslaan</button>
    <button type="button" @onclick="Cancel" class="btn btn-secondary">❌ Annuleren</button>
</EditForm>

@code {
    [Parameter]
    public string? Id { get; set; }

    private Show Show = new();
    private bool IsEdit => Id != null;

    protected override async Task OnInitializedAsync()
    {
        if (IsEdit)
        {
            var existing = await ShowService.GetByIdAsync(Id!);
            if (existing != null)
                Show = existing;
        }
        else
        {
            Show.KdmExpires = DateTime.Today;
        }
    }

    private async Task HandleValidSubmit()
    {
        if (IsEdit)
            await ShowService.UpdateAsync(Show);
        else
        {
            Show.Id = Guid.NewGuid().ToString();
            await ShowService.CreateAsync(Show);
        }

        var uri = new Uri(Nav.BaseUri);
        Nav.NavigateTo($"{uri.AbsolutePath}shows");

    }

    private void Cancel()
    {
        var uri = new Uri(Nav.BaseUri);
        Nav.NavigateTo($"{uri.AbsolutePath}shows");
    }
}